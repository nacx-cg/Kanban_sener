# Database - use cloud PostgreSQL for Vercel (Neon, Supabase, Vercel Postgres, etc.)
# Use pooled connection string when available (e.g. ?pgbouncer=true for Neon)
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# NextAuth v5 - required for production
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-project.vercel.app"

# Optional: comma-separated admin emails
ADMIN_EMAILS="admin@example.com"
