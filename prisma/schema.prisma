// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boards       Board[]
  assignedTasks Task[]  @relation("TaskAssignee")
  createdTasks Task[]   @relation("TaskCreator")
  stats        UserStats?
  achievements Achievement[]
  editedMessages MotivationalMessage[] @relation("MessageEditor")
  teamMemberships UserTeam[]
  auditLogs    AuditLog[]
}

model Team {
  id        String   @id @default(cuid())
  name      String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  boards Board[]
  members UserTeam[]
}

model UserTeam {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
}

model Board {
  id          String   @id @default(cuid())
  name        String
  description String?
  teamId      String?
  userId      String
  columns     Json     @default("[\"todo\", \"inProgress\", \"review\", \"done\"]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team  Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  tasks Task[]
  
  @@index([userId])
  @@index([teamId])
}

model Task {
  id            String    @id @default(cuid())
  boardId       String
  createdById   String
  title         String
  description   String?
  workType      String    @default("task")
  priority      String    @default("medium")
  status        String    @default("todo")
  assigneeId    String?
  dueDate       DateTime?
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  timeInColumns Json      @default("{}")
  tags          Json      @default("[]")

  board     Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  assignee  User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User       @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  history   TaskHistory[]

  @@index([boardId])
  @@index([createdById])
}

model TaskHistory {
  id        String   @id @default(cuid())
  taskId    String
  fromColumn String?
  toColumn  String
  timestamp DateTime @default(now())
  duration  Int?     // Duration in seconds

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([timestamp])
}

model Achievement {
  id        String   @id @default(cuid())
  userId    String
  type      String
  unlockedAt DateTime @default(now())
  metadata  Json     @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserStats {
  id                 String    @id @default(cuid())
  userId             String    @unique
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  totalTasksCompleted Int      @default(0)
  weeklyGoal         Int       @default(5)
  lastActivityDate   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MotivationalMessage {
  id          String   @id @default(cuid())
  key         String   // e.g., "goodMorning", "streakMilestone", "goalProgress", "keepGoing"
  message     String
  locale      String   @default("es") // "es" or "en"
  changedBy   String?  // userId of who last changed it
  changedAt   DateTime @default(now()) @updatedAt
  changedByUser User?  @relation("MessageEditor", fields: [changedBy], references: [id], onDelete: SetNull)

  @@unique([key, locale])
  @@index([key])
  @@index([locale])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  userId     String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([userId, action])
  @@index([createdAt])
}
